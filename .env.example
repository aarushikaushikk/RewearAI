# ReWear AI environment variables. Copy to .env.local and fill in real values.
# Never commit .env.local. On Vercel, set these in the project settings instead.

# MongoDB Atlas connection string (Atlas > Connect > Drivers).
# Include the database name in the path, e.g. /rewear. Until src/lib/db.ts sets a timeout,
# add serverSelectionTimeoutMS=5000 to avoid waiting 30 seconds during an outage.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/rewear?retryWrites=true&w=majority

# Required in production: the app's exact origin, e.g. https://your-app.vercel.app.
# Without it, sign-up, sign-in, and sign-out return 403. Leave empty for local development.
APP_ORIGIN=

# Set to true only behind a proxy that overwrites X-Forwarded-For, such as Vercel. Rate limits
# then apply per client. Otherwise all visitors share one limit, so keep false locally.
TRUST_PROXY=false

# Cloudinary (Dashboard > API Keys). For clothing image uploads; not used by sign-in.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Vercel only: skips downloading the test database binary during builds.
# MONGOMS_DISABLE_POSTINSTALL=1
